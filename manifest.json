{
  "manifest_version": 3,
  "name": "hevilking的浏览器主页",
  "short_name": "hevilking主页",
  "version": "1.0.2",
  "version_name": "1.0.2",
  "description": "一个极简的浏览器主页扩展，支持搜索引擎切换、快捷方式和壁纸切换",
  "author": "hevilking",
  "homepage_url": "https://hevilking.com",
  "minimum_edge_version": "110.0.0.0",
  "offline_enabled": true,
  "incognito": "split",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.bing.com/*",
    "https://www.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.baidu.com/*",
    "https://suggestion.baidu.com/*",
    "https://duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "/assets/images/icon16.png",
    "32": "/assets/images/icon32.png",
    "48": "/assets/images/icon48.png",
    "128": "/assets/images/icon.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.bing.com https://www.bing.com https://suggestqueries.google.com https://www.baidu.com https://suggestion.baidu.com https://duckduckgo.com"
  }
}
