{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "1.0.2",
  "version_name": "1.0.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "author": "hevilking",
  "homepage_url": "https://github.com/hevilking/hevilking-browser-home",
  "minimum_edge_version": "110.0.0.0",
  "offline_enabled": true,
  "incognito": "split",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.bing.com/*",
    "https://www.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.baidu.com/*",
    "https://suggestion.baidu.com/*",
    "https://duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "/assets/images/icon16.png",
    "32": "/assets/images/icon32.png",
    "48": "/assets/images/icon48.png",
    "128": "/assets/images/icon.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.bing.com https://www.bing.com https://suggestqueries.google.com https://www.baidu.com https://suggestion.baidu.com https://duckduckgo.com"
  }
}
